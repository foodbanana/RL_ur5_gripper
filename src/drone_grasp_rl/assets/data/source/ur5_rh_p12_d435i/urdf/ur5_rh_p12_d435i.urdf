  <!-- left finger, distal (mimic) -->
  <joint name="rh_l2" type="revolute">
    <parent link="rh_p12_rn_l1"/>
    <child link="rh_p12_rn_l2"/>
    <origin rpy="0 0 0" xyz="0.0 -0.0493634 0.0285"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000" lower="0.0" upper="1.13514578304" velocity="6.5"/>
    <dynamics damping="0.7"/>
    <mimic joint="rh_r1_joint" multiplier="1"/>
  </joint>
  <link name="rh_p12_rn_l2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rh_p12_rn_a/l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rh_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/rh_p12_rn_a/l2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 -0.0064 0.0112"/>
      <mass value="0.022"/>
      <inertia ixx="4.914e-06" ixy="0.0" ixz="0.0" iyy="5.497e-06" iyz="-8.339e-07" izz="1.896e-06"/>
    </inertial>
  </link>
  <!-- TCP: between the finger pads. Fingertips sit at z~0.117 (open) ~ 0.145 (closed),
         pad centre moves roughly z 0.09 ~ 0.12. 0.11 is a middle value; adjust if needed. -->
  <joint name="rh_p12_rn_tcp_joint" type="fixed">
    <parent link="rh_p12_rn_base"/>
    <child link="rh_p12_rn_tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0.11"/>
  </joint>
  <link name="rh_p12_rn_tcp"/>
  <!-- ================= wrist camera (D435i) =================
       use_nominal_extrinsics=true -> creates camera_color_frame / camera_color_optical_frame
       (in the real robot the driver publishes these; in sim we need them in the model). -->
  <joint name="wrist_camera_mount_joint" type="fixed">
    <parent link="wrist_mount"/>
    <child link="wrist_camera_mount"/>
    <origin rpy="0.17453292519943295 0 0" xyz="0 0.0575 0.005"/>
  </joint>
  <link name="wrist_camera_mount"/>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="wrist_camera_joint" type="fixed">
    <origin rpy="-1.5708 -1.5708 0.0" xyz="-0.0325 -0.0125 0.01015"/>
    <parent link="wrist_camera_mount"/>
    <child link="wrist_camera_bottom_screw_frame"/>
  </joint>
  <link name="wrist_camera_bottom_screw_frame"/>
  <joint name="wrist_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="wrist_camera_bottom_screw_frame"/>
    <child link="wrist_camera_link"/>
  </joint>
  <link name="wrist_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="../meshes/realsense/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="wrist_camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_depth_frame"/>
  </joint>
  <link name="wrist_camera_depth_frame"/>
  <joint name="wrist_camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_depth_frame"/>
    <child link="wrist_camera_depth_optical_frame"/>
  </joint>
  <link name="wrist_camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="wrist_camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra1_frame"/>
  </joint>
  <link name="wrist_camera_infra1_frame"/>
  <joint name="wrist_camera_infra1_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra1_frame"/>
    <child link="wrist_camera_infra1_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra1_optical_frame"/>
  <!-- camera right IR joints and links -->
  <joint name="wrist_camera_infra2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.05 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_infra2_frame"/>
  </joint>
  <link name="wrist_camera_infra2_frame"/>
  <joint name="wrist_camera_infra2_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_infra2_frame"/>
    <child link="wrist_camera_infra2_optical_frame"/>
  </joint>
  <link name="wrist_camera_infra2_optical_frame"/>
  <!-- camera color joints and links -->
  <joint name="wrist_camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.015 0"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_color_frame"/>
  </joint>
  <link name="wrist_camera_color_frame"/>
  <joint name="wrist_camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_color_frame"/>
    <child link="wrist_camera_color_optical_frame"/>
  </joint>
  <link name="wrist_camera_color_optical_frame"/>
  <link name="wrist_camera_accel_frame"/>
  <link name="wrist_camera_accel_optical_frame"/>
  <link name="wrist_camera_gyro_frame"/>
  <link name="wrist_camera_gyro_optical_frame"/>
  <joint name="wrist_camera_accel_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.01174 -0.00552 0.0051"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_accel_frame"/>
  </joint>
  <joint name="wrist_camera_accel_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_accel_frame"/>
    <child link="wrist_camera_accel_optical_frame"/>
  </joint>
  <joint name="wrist_camera_gyro_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.01174 -0.00552 0.0051"/>
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_gyro_frame"/>
  </joint>
  <joint name="wrist_camera_gyro_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="wrist_camera_gyro_frame"/>
    <child link="wrist_camera_gyro_optical_frame"/>
  </joint>
</robot>
